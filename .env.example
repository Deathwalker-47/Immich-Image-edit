# ============================================================
# Immich AI Photo Editor — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Immich Connection ---
# Internal Docker URL (if running in same Docker network as Immich)
IMMICH_INTERNAL_URL=http://immich-server:2283
# Public URL for frontend to display images
IMMICH_PUBLIC_URL=https://your-immich-domain.com
# Your Immich API key (Account Settings > API Keys)
IMMICH_API_KEY=your_immich_api_key_here

# --- AI Provider API Keys ---
# Fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# Runware — https://runware.ai/account/api-keys
RUNWARE_API_KEY=your_runware_api_key_here

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Atlas Cloud — https://www.atlascloud.ai/dashboard
ATLAS_API_KEY=your_atlas_api_key_here

# --- App Config ---
# Port for backend API server
BACKEND_PORT=3778
# Port for frontend
FRONTEND_PORT=3777
# Name of Immich Docker network (from `docker network ls`)
IMMICH_NETWORK=immich_default
# Album name to save AI edits into (will be created if it doesn't exist)
AI_EDITS_ALBUM_NAME=AI Edits
# Node environment
NODE_ENV=production
